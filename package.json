{
	"name": "usertrust-monorepo",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"evidence:capture": "tsx scripts/capture-evidence.mts",
		"evidence:test": "node --import tsx --test scripts/capture-evidence.test.mts",
		"fleet:collect": "tsx scripts/fleet-collector.mts",
		"fleet:test": "node --import tsx --test scripts/fleet/*.test.mts",
		"typecheck": "tsc -b && tsc -p packages/core/tsconfig.type-tests.json && tsc -p packages/openclaw/tsconfig.type-tests.json",
		"typecheck:types": "tsc -p packages/core/tsconfig.type-tests.json"
	},
	"devDependencies": {
		"@anthropic-ai/sdk": "^0.115.0",
		"@biomejs/biome": "^2.5.6",
		"@types/node": "^26.1.2",
		"@vitest/coverage-v8": "^4.1.0",
		"openai": "^7.3.0",
		"tsx": "^4.19.0",
		"typescript": "^5.9.0",
		"vitest": "^4.0.0"
	},
	"packageManager": "npm@10.9.2+sha512.8ab88f10f224a0c614cb717a7f7c30499014f77134120e9c1f0211ea3cf3397592cbe483feb38e0c4b3be1c54e347292c76a1b5edb94a3289d5448484ab8ac81"
}
